NODE_ENV=development
# HTTP_HOST=0.0.0.0
# HTTP_BODY_LIMIT_BYTES=1048576
# HTTP_SHUTDOWN_TIMEOUT_MS=15000
# DB_STATEMENT_TIMEOUT_MS=30000
# WARMUP_WORKER_POLL_INTERVAL_MS=30000
# INBOUND_WORKER_POLL_INTERVAL_MS=30000
# CLASSIFICATION_WORKER_POLL_INTERVAL_MS=15000
# POLICY_WORKER_POLL_INTERVAL_MS=15000

# Port 5433, not 5432: this service's docker-compose.yml deliberately avoids
# the Postgres/Redis default ports so it never collides with another Skout
# repository's infrastructure that might already be running locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skout_warmup
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6380

LOG_LEVEL=info

ENCRYPTION_KEY=
API_KEY_PEPPER=

# Optional, and each provider's three values are all-or-nothing (see
# src/shared/config/schema.ts). Leave every line below unset/commented for a
# deployment that never connects Gmail/Microsoft 365 mailboxes — that
# provider's adapter simply reports NOT_CONFIGURED rather than the service
# refusing to start.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3010/api/v1/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:3010/api/v1/oauth/microsoft/callback

# Bounds the OAuth access-token refresh network call, independent from
# each provider's own (hardcoded) 15s send timeout (Stage 12.1). Optional —
# defaults to 10000ms.
# PROVIDER_CREDENTIAL_REFRESH_TIMEOUT_MS=10000

# Stage 13B/13C conversation classification (facts only). Default none — the
# API and inbound poller start without an AI key. Deterministic classification
# still runs. The worker does not send mail.
# AI_CLASSIFICATION_PROVIDER=none
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=gpt-4.1-mini
# AI_CLASSIFICATION_TIMEOUT_MS=15000
# AI_MAX_INPUT_CHARS=8000
# AI_MAX_OUTPUT_CHARS=2000
# AI_CLASSIFIER_VERSION=conversation-classifier/v1
# CLASSIFICATION_TAXONOMY_VERSION=classification-taxonomy/v1
# AI_CLASSIFICATION_SUPPLEMENT=false

# Stage 14 conversation policy signals (facts → signals only; never sends or suppresses).
# CONVERSATION_POLICY_VERSION=conversation-policy/v1
# CONVERSATION_POLICY_TAXONOMY_VERSION=conversation-policy-taxonomy/v1

# Stage 20/21 Skout-managed warmup network (recipient routing only).
# Default off = self-send and no network DB lookup (instant disable).
# Tables ≠ a live partner fleet. See docs/WARMUP_NETWORK.md.
# WARMUP_NETWORK_ROUTING_MODE=off
# WARMUP_NETWORK_RECENT_INTERACTION_WINDOW_MS=604800000
# WARMUP_NETWORK_DEFAULT_DAILY_CAPACITY=50
# WARMUP_NETWORK_MIN_HEALTH_SCORE=50
# WARMUP_NETWORK_COOLDOWN_MS=3600000
# WARMUP_NETWORK_REQUIRE_SPF=true
# WARMUP_NETWORK_REQUIRE_DKIM=true
# WARMUP_NETWORK_REQUIRE_DMARC=true

# Stage 20 tenant sending-identity pools (optional WHO selector; not the partner network).
# WARMUP_POOL_SELECTION_STRATEGY=health_first_least_used
# WARMUP_MAX_DOMAIN_SHARE_PERCENT=70
# WARMUP_MAX_CONSECUTIVE_SAME_DOMAIN=2
# WARMUP_POOL_SELECTION_COOLDOWN_MS=0

# Stage 17/18/19 integration pull (policy signals → outbox). See
# docs/SOFTWARE_ENGINEER_HANDOFF.md, docs/INTEGRATION_CONTRACT.md,
# docs/PRODUCTION_HANDOFF.md, and docs/ENVIRONMENT_REFERENCE.md.
# No publisher. Contract: conversation-integration/v1.


# Full env catalog: docs/ENVIRONMENT_REFERENCE.md
#
# Only used by `npm run test:db` (tests/db/**), never by the app itself.
# A separate database so integration tests never touch development data —
# created on demand by the test suite itself (tests/db/support.ts) the
# first time it runs, regardless of whether the postgres volume is fresh.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skout_warmup_test
# Optional. Default in tests/db/support.ts is redis://localhost:6380/1
# (logical DB 1 so tests never FLUSHDB the developer's DB 0).
# TEST_REDIS_URL=redis://localhost:6380/1
