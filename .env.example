NODE_ENV=development
PORT=3010

# Port 5433, not 5432: this service's docker-compose.yml deliberately avoids
# the Postgres/Redis default ports so it never collides with another Skout
# repository's infrastructure that might already be running locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skout_warmup
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6380

LOG_LEVEL=info

ENCRYPTION_KEY=
API_KEY_PEPPER=

# Optional, and each provider's three values are all-or-nothing (see
# src/shared/config/schema.ts). Leave every line below unset/commented for a
# deployment that never connects Gmail/Microsoft 365 mailboxes — that
# provider's adapter simply reports NOT_CONFIGURED rather than the service
# refusing to start.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3010/api/v1/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:3010/api/v1/oauth/microsoft/callback

# Only used by `npm run test:db` (tests/db/**), never by the app itself.
# A separate database so integration tests never touch development data —
# created on demand by the test suite itself (tests/db/support.ts) the
# first time it runs, regardless of whether the postgres volume is fresh.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skout_warmup_test
